{% extends 'basebackoffice.html.twig' %}

{% block title %}Create Driver{% endblock %}

{% block content %}
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Add New Driver</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_driver_admin_index') }}">Drivers</a></li>
                    <li class="breadcrumb-item active">Add New</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <!-- Custom Tabs -->
                <div class="card">
                    <div class="card-header p-0">
                        <ul class="nav nav-tabs" id="driver-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="driver-details-tab" data-toggle="pill" href="#driver-details" role="tab">
                                    <i class="fas fa-user-tie"></i> Driver Details
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="vehicle-details-tab" data-toggle="pill" href="#vehicle-details" role="tab">
                                    <i class="fas fa-car"></i> Vehicle Information
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="documentation-tab" data-toggle="pill" href="#documentation" role="tab">
                                    <i class="fas fa-file-alt"></i> Documentation
                                </a>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="card-body">
                        <div class="tab-content" id="driver-tabs-content">
                            <!-- Driver Details Tab -->
                            <div class="tab-pane fade show active" id="driver-details" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-8">
                                        {{ include('driver_admin/_form.html.twig', {'button_label': 'Save Driver', 'button_class': 'btn btn-primary'}) }}
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <div class="card card-outline card-info">
                                            <div class="card-header">
                                                <h3 class="card-title">Driver Requirements</h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="callout callout-info">
                                                    <h5>Required Documentation</h5>
                                                    <ul>
                                                        <li>Valid driving license</li>
                                                        <li>Vehicle registration</li>
                                                        <li>Insurance documentation</li>
                                                        <li>Background check clearance</li>
                                                    </ul>
                                                </div>
                                                
                                                <div class="info-box bg-gradient-success">
                                                    <span class="info-box-icon"><i class="fas fa-check"></i></span>
                                                    <div class="info-box-content">
                                                        <span class="info-box-text">Driver Approval Process</span>
                                                        <span class="info-box-number">Complete all fields for faster approval</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Vehicle Information Tab -->
                            <div class="tab-pane fade" id="vehicle-details" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="card card-primary">
                                            <div class="card-header">
                                                <h3 class="card-title">Vehicle Details</h3>
                                            </div>
                                            <div class="card-body">
                                                <p class="text-center">
                                                    <i class="fas fa-info-circle"></i> 
                                                    Please fill the driver details first, then continue with vehicle information
                                                </p>
                                                
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>Car Model</label>
                                                            <input type="text" class="form-control" placeholder="e.g. Toyota Camry">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>Car Color</label>
                                                            <select class="form-control">
                                                                <option value="Black">Black</option>
                                                                <option value="White">White</option>
                                                                <option value="Silver">Silver</option>
                                                                <option value="Blue">Blue</option>
                                                                <option value="Red">Red</option>
                                                                <option value="Other">Other</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>License Plate</label>
                                                            <input type="text" class="form-control" placeholder="e.g. ABC-123">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>Max Luggage</label>
                                                            <select class="form-control">
                                                                <option value="1">1 piece</option>
                                                                <option value="2">2 pieces</option>
                                                                <option value="3">3 pieces</option>
                                                                <option value="4">4 pieces</option>
                                                                <option value="5">5+ pieces</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="card card-warning">
                                            <div class="card-header">
                                                <h3 class="card-title">Vehicle Photos</h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label>Front View</label>
                                                    <div class="input-group">
                                                        <div class="custom-file">
                                                            <input type="file" class="custom-file-input">
                                                            <label class="custom-file-label">Choose file</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="form-group">
                                                    <label>Side View</label>
                                                    <div class="input-group">
                                                        <div class="custom-file">
                                                            <input type="file" class="custom-file-input">
                                                            <label class="custom-file-label">Choose file</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="form-group">
                                                    <label>Interior</label>
                                                    <div class="input-group">
                                                        <div class="custom-file">
                                                            <input type="file" class="custom-file-input">
                                                            <label class="custom-file-label">Choose file</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Documentation Tab -->
                            <div class="tab-pane fade" id="documentation" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="callout callout-danger">
                                            <h5><i class="fas fa-exclamation-triangle"></i> Important Notice</h5>
                                            <p>All documents must be clear, valid, and up-to-date. Expired or unclear documents will delay the approval process.</p>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="card card-outline card-primary">
                                            <div class="card-header">
                                                <h3 class="card-title">Driving License</h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label>License Number</label>
                                                    <input type="text" class="form-control" placeholder="Enter license number">
                                                </div>
                                                <div class="form-group">
                                                    <label>Expiry Date</label>
                                                    <div class="input-group date" id="licenseDatetimepicker" data-target-input="nearest">
                                                        <input type="text" class="form-control datetimepicker-input" data-target="#licenseDatetimepicker" placeholder="Select date">
                                                        <div class="input-group-append" data-target="#licenseDatetimepicker" data-toggle="datetimepicker">
                                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label>Upload License Scan</label>
                                                    <div class="input-group">
                                                        <div class="custom-file">
                                                            <input type="file" class="custom-file-input">
                                                            <label class="custom-file-label">Choose file</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <div class="card card-outline card-success">
                                            <div class="card-header">
                                                <h3 class="card-title">Vehicle Registration</h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label>Registration Number</label>
                                                    <input type="text" class="form-control" placeholder="Enter registration number">
                                                </div>
                                                <div class="form-group">
                                                    <label>Expiry Date</label>
                                                    <div class="input-group date" id="regDatetimepicker" data-target-input="nearest">
                                                        <input type="text" class="form-control datetimepicker-input" data-target="#regDatetimepicker" placeholder="Select date">
                                                        <div class="input-group-append" data-target="#regDatetimepicker" data-toggle="datetimepicker">
                                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label>Upload Registration Document</label>
                                                    <div class="input-group">
                                                        <div class="custom-file">
                                                            <input type="file" class="custom-file-input">
                                                            <label class="custom-file-label">Choose file</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <div class="card card-outline card-info">
                                            <div class="card-header">
                                                <h3 class="card-title">Insurance</h3>
                                            </div>
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label>Insurance Provider</label>
                                                    <input type="text" class="form-control" placeholder="Enter insurance company">
                                                </div>
                                                <div class="form-group">
                                                    <label>Policy Number</label>
                                                    <input type="text" class="form-control" placeholder="Enter policy number">
                                                </div>
                                                <div class="form-group">
                                                    <label>Upload Insurance Certificate</label>
                                                    <div class="input-group">
                                                        <div class="custom-file">
                                                            <input type="file" class="custom-file-input">
                                                            <label class="custom-file-label">Choose file</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer">
                        <div class="float-right">
                            <button type="button" class="btn btn-primary" id="save-driver">
                                <i class="fas fa-save"></i> Save Driver
                            </button>
                            <a href="{{ path('app_driver_admin_index') }}" class="btn btn-default">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
$(function () {
    // Initialize datepicker if it exists
    if ($.fn.datetimepicker) {
        $('#licenseDatetimepicker, #regDatetimepicker').datetimepicker({
            format: 'L'
        });
    }
    
    // Custom file input
    $(document).on('change', '.custom-file-input', function() {
        var fileName = $(this).val().split('\\').pop();
        $(this).siblings('.custom-file-label').addClass('selected').html(fileName);
    });
    
    // Save driver button functionality
    $('#save-driver').on('click', function() {
        // Submit the actual form
        $('form').submit();
    });
    
    // Make tabs clickable and retain state
    $('#driver-tabs a').on('click', function (e) {
        e.preventDefault();
        $(this).tab('show');
    });
    
    // Store active tab in localStorage
    $('a[data-toggle="pill"]').on('shown.bs.tab', function (e) {
        localStorage.setItem('activeDriverTab', $(e.target).attr('href'));
    });
    
    // Check for active tab in localStorage
    var activeTab = localStorage.getItem('activeDriverTab');
    if (activeTab) {
        $('#driver-tabs a[href="' + activeTab + '"]').tab('show');
    }
});
</script>
{% endblock %}