{# edit.html.twig #}
{% extends 'basefrontoffice.html.twig' %}

{% block title %}Edit Reservation{% endblock %}

{% block section8 %}
<div class="reservation-form-wrapper">
    <div class="reservation-form-header">
        <h1>Edit Reservation</h1>
        <div class="header-actions">
            <a href="{{ path('app_reservation_index') }}" class="back-btn">
                <i class="ti-arrow-left"></i> Back to Reservations
            </a>
        </div>
    </div>
    
    <div class="reservation-form-container">
        <div class="reservation-form-icon edit">
            <i class="ti-pencil"></i>
        </div>
        {{ include('reservation/_form.html.twig', {'button_label': 'Update'}) }}
        
        <div class="delete-container">
            <hr class="divider">
            <h3>Delete this Reservation</h3>
            <p>This action cannot be undone. Please be certain.</p>
            {{ include('reservation/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}

{% block css %}
    {{ parent() }}
    <style>
        .reservation-form-wrapper {
            padding: 50px 15px;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .reservation-form-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eaeaea;
        }
        
        .reservation-form-header h1 {
            font-size: 32px;
            color: #263A5B;
            margin: 0;
            font-weight: 600;
        }
        
        .header-actions {
            display: flex;
            gap: 10px;
        }
        
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #777;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
            padding: 8px 16px;
            border-radius: 30px;
            background-color: #f5f5f5;
        }
        
        .back-btn:hover {
            background-color: #e9e9e9;
            color: #263A5B;
        }
        
        .reservation-form-container {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            padding: 30px;
            position: relative;
        }
        
        .reservation-form-icon {
            width: 70px;
            height: 70px;
            background-color: #FF9F67;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: -35px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 28px;
            box-shadow: 0 3px 10px rgba(255, 159, 103, 0.3);
        }
        
        .reservation-form-icon.edit {
            background-color: #007BFF;
            box-shadow: 0 3px 10px rgba(0, 123, 255, 0.3);
        }
        
        /* Form Styling - Adjust based on your form structure */
        form label {
            font-weight: 500;
            color: #263A5B;
            margin-bottom: 8px;
            display: block;
        }
        
        form input[type="text"],
        form input[type="email"],
        form input[type="number"],
        form select,
        form textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        form input:focus,
        form select:focus,
        form textarea:focus {
            outline: none;
            border-color: #FF9F67;
            box-shadow: 0 0 0 3px rgba(255, 159, 103, 0.1);
        }
        
        form button[type="submit"] {
            background-color: #007BFF;
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 16px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-block;
            font-weight: 500;
            margin-top: 10px;
        }
        
        form button[type="submit"]:hover {
            background-color: #0069d9;
            transform: translateY(-2px);
        }
        
        .divider {
            margin: 40px 0 20px;
            border: none;
            border-top: 1px solid #eaeaea;
        }
        
        .delete-container {
            margin-top: 30px;
        }
        
        .delete-container h3 {
            color: #dc3545;
            font-size: 18px;
            margin-bottom: 10px;
        }
        
        .delete-container p {
            color: #777;
            margin-bottom: 20px;
            font-size: 14px;
        }
        
        /* Delete Form Styling */
        form.delete-form button {
            background-color: #fff;
            color: #dc3545;
            border: 1px solid #dc3545;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        form.delete-form button:hover {
            background-color: #dc3545;
            color: white;
        }
        
        @media (max-width: 768px) {
            .reservation-form-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
        }
    </style>
{% endblock %}