{% extends 'basefrontoffice.html.twig' %}

{% block title %}Reservation Details{% endblock %}

{% block section8 %}
<div class="reservation-detail-wrapper">
    <div class="reservation-detail-header">
        <h1>Reservation Details</h1>
        <div class="header-actions">
            <a href="{{ path('app_reservation_index') }}" class="back-btn">
                <i class="ti-arrow-left"></i> Back to Reservations
            </a>
            <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="edit-btn">
                <i class="ti-pencil"></i> Edit
            </a>
        </div>
    </div>
    
    <div class="reservation-detail-card">
        <div class="reservation-status {{ reservation.status|lower }}">
            <span class="status-badge">{{ reservation.status }}</span>
            <span class="reservation-id">#{{ reservation.id }}</span>
        </div>
        
        <div class="reservation-detail-body">
            <div class="journey-section">
                <h3 class="section-title"><i class="ti-map-alt"></i> Journey Details</h3>
                
                <div class="journey-info">
                    <div class="location-container">
                        <div class="location">
                            <div class="location-icon pickup">
                                <i class="ti-location-pin"></i>
                            </div>
                            <div class="location-details">
                                <span class="label">From</span>
                                <h4>{{ reservation.pickupAddress }}</h4>
                            </div>
                        </div>
                        
                        <div class="route-line">
                            <span class="dot start"></span>
                            <span class="line"></span>
                            <span class="dot end"></span>
                        </div>
                        
                        <div class="location">
                            <div class="location-icon destination">
                                <i class="ti-map-alt"></i>
                            </div>
                            <div class="location-details">
                                <span class="label">To</span>
                                <h4>{{ reservation.destinationAddress }}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="details-section">
                <h3 class="section-title"><i class="ti-info-alt"></i> Additional Information</h3>
                
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Price</span>
                        <span class="detail-value price">{{ reservation.price ? reservation.price ~ ' TND' : 'Not specified' }}</span>
                    </div>
                    
                    <div class="detail-item">
                        <span class="detail-label">Status</span>
                        <span class="detail-value status {{ reservation.status|lower }}">{{ reservation.status }}</span>
                    </div>
                    
                    <div class="detail-item">
                        <span class="detail-label">Created On</span>
                        <span class="detail-value">{{ reservation.createdAt ? reservation.createdAt|date('M d, Y - H:i') : 'Not available' }}</span>
                    </div>
                    
                    <div class="detail-item">
                        <span class="detail-label">Estimated Duration</span>
                        <span class="detail-value">{{ reservation.estimatedDuration ?: 'Not specified' }}</span>
                    </div>
                    
                    {% if reservation.sepcialRequests %}
                    <div class="detail-item full-width">
                        <span class="detail-label">Special Requests</span>
                        <div class="detail-value special-requests">
                            {{ reservation.sepcialRequests }}
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            <div class="delete-section">
                <h3 class="section-title danger"><i class="ti-trash"></i> Delete Reservation</h3>
                <p class="delete-warning">This action cannot be undone. Please be certain.</p>
                {{ include('reservation/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block css %}
    {{ parent() }}
    <style>
        .reservation-detail-wrapper {
            padding: 50px 15px;
            max-width: 900px;
            margin: 0 auto;
        }
        
        .reservation-detail-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eaeaea;
        }
        
        .reservation-detail-header h1 {
            font-size: 32px;
            color: #263A5B;
            margin: 0;
            font-weight: 600;
        }
        
        .header-actions {
            display: flex;
            gap: 10px;
        }
        
        .back-btn, .edit-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
            padding: 8px 16px;
            border-radius: 30px;
        }
        
        .back-btn {
            color: #777;
            background-color: #f5f5f5;
        }
        
        .edit-btn {
            color: white;
            background-color: #007BFF;
        }
        
        .back-btn:hover {
            background-color: #e9e9e9;
            color: #263A5B;
        }
        
        .edit-btn:hover {
            background-color: #0069d9;
        }
        
        .reservation-detail-card {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            overflow: hidden;
        }
        
        .reservation-status {
            display: flex;
            justify-content: space-between;
            padding: 15px 20px;
            color: white;
        }
        
        .reservation-status.pending {
            background-color: #FFC107;
        }
        
        .reservation-status.confirmed {
            background-color: #4CAF50;
        }
        
        .reservation-status.cancelled {
            background-color: #F44336;
        }
        
        .status-badge {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .reservation-id {
            opacity: 0.8;
        }
        
        .reservation-detail-body {
            padding: 30px;
        }
        
        .section-title {
            font-size: 18px;
            color: #263A5B;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        
        .section-title i {
            color: #FF9F67;
        }
        
        .section-title.danger i {
            color: #dc3545;
        }
        
        .journey-section, .details-section {
            margin-bottom: 30px;
        }
        
        .journey-info {
            background-color: #f9f9f9;
            padding: 20px;
            border-radius: 8px;
        }
        
        .location-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            position: relative;
        }
        
        .location {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .location-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }
        
        .location-icon.pickup {
            background-color: #FF9F67;
        }
        
        .location-icon.destination {
            background-color: #263A5B;
        }
        
        .location-details h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
            color: #263A5B;
        }
        
        .label {
            display: block;
            font-size: 12px;
            color: #777;
            margin-bottom: 3px;
        }
        
        .route-line {
            position: absolute;
            left: 20px;
            top: 40px;
            bottom: 40px;
            width: 2px;
            background: linear-gradient(to bottom, #FF9F67, #263A5B);
        }
        
        .route-line .dot {
            position: absolute;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            left: -4px;
        }
        
        .dot.start {
            top: -5px;
            background-color: #FF9F67;
        }
        
        .dot.end {
            bottom: -5px;
            background-color: #263A5B;
        }
        
        .detail-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        
        .detail-item {
            background-color: #f9f9f9;
            padding: 15px;
            border-radius: 8px;
        }
        
        .detail-item.full-width {
            grid-column: 1 / -1;
        }
        
        .detail-label {
            display: block;
            font-size: 12px;
            color: #777;
            margin-bottom: 5px;
        }
        
        .detail-value {
            font-size: 16px;
            font-weight: 500;
            color: #263A5B;
        }
        
        .detail-value.price {
            color: #FF9F67;
            font-weight: 600;
        }
        
        .detail-value.status {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            color: white;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .detail-value.status.pending {
            background-color: #FFC107;
        }
        
        .detail-value.status.confirmed {
            background-color: #4CAF50;
        }
        
        .detail-value.status.cancelled {
            background-color: #F44336;
        }
        
        .detail-value.special-requests {
            font-size: 14px;
            line-height: 1.6;
            white-space: pre-line;
        }
        
        .delete-section {
            border-top: 1px solid #eaeaea;
            padding-top: 20px;
            margin-top: 30px;
        }
        
        .section-title.danger {
            color: #dc3545;
        }
        
        .delete-warning {
            color: #777;
            margin-bottom: 20px;
            font-size: 14px;
        }
        
        /* Delete Form Styling */
        form.delete-form button {
            background-color: #fff;
            color: #dc3545;
            border: 1px solid #dc3545;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        form.delete-form button:hover {
            background-color: #dc3545;
            color: white;
        }
        
        @media (max-width: 768px) {
            .reservation-detail-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .header-actions {
                width: 100%;
                justify-content: flex-start;
            }
            
            .detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}