{% extends 'basefrontoffice.html.twig' %}

{% block title %}Driver index{% endblock %}

{% block section8 %}
    <h1>Driver index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>CarModel</th>
                <th>CarColor</th>
                <th>LicensePlate</th>
                <th>MaxLuggage</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for driver in drivers %}
            <tr>
                <td>{{ driver.id }}</td>
                <td>{{ driver.carModel }}</td>
                <td>{{ driver.carColor }}</td>
                <td>{{ driver.licensePlate }}</td>
                <td>{{ driver.maxLuggage }}</td>
                <td>
                    <a href="{{ path('app_driver_show', {'id': driver.id}) }}">show</a>
                    <a href="{{ path('app_driver_edit', {'id': driver.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_driver_new') }}">Create new</a>
{% endblock %}
